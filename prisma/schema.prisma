generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email    String     @unique
  name     String?
  role     Role       @default(USER)
  image           String?   
  emailVerified DateTime? 
  password      String?
  status   UserStatus @default(INACTIVE)
  createdAt  DateTime   @default(now())
  termsCondition Boolean @default(true)
  accounts      Account[]
  @@map("users")

}

enum Role {
  USER
  PRODUCT_OWNER 
  WORKSPACE_MANAGER
  PRODUCT_DESIGNER
  DATA_ANALYST
  TECH_LEAD
  SUPPORT_TEAM
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")    // Changed from Int to String to match User.id
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Section {
  id        String     @id @default(cuid())
  name      String
  order     Int
  menus     Menu[]
}

model Menu {
  id         String    @id @default(cuid())
  icon       String?
  label      String
  path       String?
  order      Int
  section    Section   @relation(fields: [sectionId], references: [id])
  sectionId  String
  parent     Menu?     @relation("MenuToSubmenu", fields: [parentId], references: [id])
  parentId   String?
  children   Menu[]    @relation("MenuToSubmenu")
}